# Copie ce fichier sous le nom ".env" et remplace les valeurs.
# Le vrai fichier .env ne doit JAMAIS être publié sur GitHub (il est dans .gitignore).
# Utilisateur de l'API : droits limités (voir db/creer_utilisateur_api.sql)
DATABASE_URL=postgresql+psycopg2://utilisateur:motdepasse@localhost:5432/technova
# Administrateur : seulement pour python -m db.create_db et db.charger_salaries (facultatif :
# s'il est absent, ces scripts utilisent DATABASE_URL).
DATABASE_ADMIN_URL=postgresql+psycopg2://utilisateur:motdepasse@localhost:5432/technova
API_KEY=change-moi
